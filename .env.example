# App
NEXT_PUBLIC_APP_NAME=RevenuePilot AI
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://localhost:5432/revenuepilot?schema=public"

# Demo merchant context
DEMO_MERCHANT_SLUG=novacart-electronics

# Optional LLM provider key (deterministic tool constraints still apply)
LLM_API_KEY=replace_with_llm_api_key

# Optional Razorpay test-mode credentials
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_with_test_secret
