# App
NEXT_PUBLIC_APP_NAME=Razorpay RevenuePilot
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://localhost:5432/revenuepilot?schema=public"

# Razorpay test mode credentials (never commit real keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_with_test_secret

# LLM provider key (server-side only)
LLM_API_KEY=replace_with_llm_api_key
